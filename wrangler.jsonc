// Cloudflare Workers (archivos estáticos): publica la app compilada en apps/web/dist.
// Solo se usa si el proyecto de Cloudflare se creó como Worker; Cloudflare Pages no lo necesita.
{
  "name": "conteo-alevinos",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Cualquier dirección sin archivo abre la app (por ejemplo /laboratorio).
    "not_found_handling": "single-page-application"
  }
}
